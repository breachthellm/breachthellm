# AI backend mode: only "local" (Ollama) is implemented today.
# "api" (OpenAI/Anthropic) is planned for a future version and has no effect yet.
AI_BACKEND_MODE=local

# Placeholders for the planned "api" mode above, not used yet.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# HMAC secret used to derive per-level challenge flags.
# Leave blank, auto-generated on first `npm run dev` and written back to your local .env.
FLAG_SECRET=

# Ollama model used for local AI backend mode.
OLLAMA_MODEL=llama3.1:8b
