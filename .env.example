# AI backend mode: "local" (Ollama, default) or "api" (OpenAI/Anthropic)
AI_BACKEND_MODE=local

# Required only if AI_BACKEND_MODE=api
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# HMAC secret used to derive per-level challenge flags.
# Leave blank, auto-generated on first `npm run dev` and written back to your local .env.
FLAG_SECRET=
